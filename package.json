{
  "name": "ai-manga-drama-web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:contracts": "vitest run tests/unit/contracts",
    "test:coverage": "node tools/quality/run-tests-with-diagnostics.mjs",
    "test:e2e:mock": "node tools/e2e/mock-scenario-suite.mjs",
    "test:e2e:mock:auth": "node tools/e2e/mock-scenario-suite.mjs --scenario=auth-session",
    "test:e2e:mock:project": "node tools/e2e/mock-scenario-suite.mjs --scenario=project-management",
    "test:e2e:mock:editor": "node tools/e2e/mock-scenario-suite.mjs --scenario=editor-persistence",
    "test:e2e:mock:recovery": "node tools/e2e/mock-scenario-suite.mjs --scenario=runtime-recovery",
    "test:e2e:mock:long": "node tools/e2e/mock-scenario-suite.mjs --scenario=editor-long-session",
    "test:e2e:a11y": "node tools/e2e/mock-scenario-suite.mjs --scenario=accessibility",
    "test:visual": "node tools/e2e/visual-regression.mjs",
    "test:visual:update": "node tools/e2e/visual-regression.mjs --update",
    "integration:auth-session": "node tools/integration/auth-session.mjs",
    "integration:project-crud": "node tools/integration/project-crud.mjs",
    "scaffold:http-module": "node tools/integration/scaffold-http-module.mjs",
    "typecheck": "node tools/quality/check-types.mjs",
    "lint": "node tools/quality/check-eslint-baseline.mjs",
    "lint:raw": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node tools/quality/check-eslint-baseline.mjs --write-baseline",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "node tools/quality/check-changed-format.mjs",
    "stylelint": "node tools/quality/check-stylelint-baseline.mjs",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
    "stylelint:baseline": "node tools/quality/check-stylelint-baseline.mjs --write-baseline",
    "check:http-mock-boundary": "node tools/quality/check-http-mock-boundary.mjs",
    "check:integration-consistency": "node tools/quality/check-integration-consistency.mjs",
    "check:source-assets": "node tools/quality/check-source-assets.mjs",
    "check:source-hygiene": "node tools/quality/check-source-hygiene.mjs",
    "check:build-budget": "node tools/quality/check-build-budget.mjs",
    "check:standards": "pnpm lint && pnpm format:check && pnpm stylelint",
    "check:static": "pnpm check:http-mock-boundary && pnpm check:integration-consistency && pnpm check:source-assets && pnpm check:source-hygiene && pnpm check:standards",
    "check:quality": "pnpm check:static && pnpm typecheck && pnpm test:coverage && pnpm build:verify",
    "report:build": "node tools/quality/report-build.mjs",
    "capture": "node tools/capture-modao.mjs",
    "dev": "vite --host 0.0.0.0",
    "build:app": "vite build",
    "build:verify": "pnpm build:app && pnpm report:build && pnpm check:build-budget",
    "build": "pnpm typecheck && pnpm build:verify",
    "preview": "vite preview --host 0.0.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "type": "module"
}
