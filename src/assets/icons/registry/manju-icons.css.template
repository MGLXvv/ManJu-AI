/* ManJu iconfont CSS template.
   Compile fonts locally into ./fonts/manju-icons.woff2 etc.
   Font files are intentionally not included in this package. */
@font-face {
  font-family: "manju-icons";
  src: url("./fonts/manju-icons.woff2") format("woff2"),
       url("./fonts/manju-icons.woff") format("woff"),
       url("./fonts/manju-icons.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: block;
}

.mj-icon {
  display: inline-block;
  font-family: "manju-icons" !important;
  font-style: normal;
  font-weight: normal;
  line-height: 1;
  speak: never;
  text-rendering: auto;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Codepoints are generated by svgtofont/fantasticon during local build. */
