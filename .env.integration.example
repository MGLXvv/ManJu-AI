# Real backend integration mode
VITE_API_MODE=http

# Keep the browser request path relative. Vite/Nginx owns the upstream target.
VITE_API_BASE_URL=/admin-api

# Local backend example. Copy this file to .env.integration.local and replace as needed.
VITE_DEV_PROXY_TARGET=http://localhost:48080

# Fail fast when integration configuration is incomplete.
VITE_STRICT_RUNTIME_CONFIG=true

# Enable only after the matching Adapter, Fixture and real environment flow have been verified.
# Example candidates after verification:
# resource.write,voice.write,generation.cancel,generation.retry,project.export
VITE_ENABLED_CAPABILITIES=

# Explicit deployment-level killswitches.
VITE_DISABLED_CAPABILITIES=

# Optional extra hosts for tunnel-based UI review.
VITE_DEV_ALLOWED_HOSTS=
