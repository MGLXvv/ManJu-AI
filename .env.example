# Runtime API mode: mock | http
VITE_API_MODE=mock

# HTTP gateway base URL. Keep only the gateway prefix; business modules append /aidrama/...
# VITE_API_BASE_URL=http://localhost:48080/admin-api

# Enable strict validation outside production when needed, for example in CI or integration testing.
VITE_STRICT_RUNTIME_CONFIG=false

# Comma-separated capability keys explicitly enabled after backend verification.
# Example: project.import,project.export,generation.cancel,generation.retry,export.task
VITE_ENABLED_CAPABILITIES=

# Comma-separated capability keys explicitly disabled for a deployment.
VITE_DISABLED_CAPABILITIES=

# Local Vite proxy target. Do not commit private server addresses to vite.config.ts.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:48080

# Comma-separated additional hosts allowed by the Vite dev server.
# VITE_DEV_ALLOWED_HOSTS=example.trycloudflare.com
